set(source "${QUICKHEAP_SEQUENCE_SOURCE_DIR}/spq/knheap.C")
file(SHA256 "${source}" source_hash)
if(NOT source_hash STREQUAL "7b046b9bff54ea4f3d19cb873b5a1b5175e3b451eb12a64568e52d5eb48f4c01" AND
   NOT source_hash STREQUAL "ffc1afb96ff3dfe4b493f4a90384acb566a94e39a0bb109b5ec385a7d8b394c8" AND
   NOT source_hash STREQUAL "cb1001329916a6ef0fba8ebbb505fa3fffe034cc56cf071681014cb80c3b6741")
    message(FATAL_ERROR "Pinned SequenceHeap source hash changed")
endif()
file(READ "${source}" contents)
set(original "*mask = 1 << (logK - 1);")
set(corrected "*mask = logK > 0 ? 1 << (logK - 1) : 0;")
string(FIND "${contents}" "${corrected}" already_patched)
if(already_patched EQUAL -1)
    string(FIND "${contents}" "${original}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Pinned SequenceHeap single-leaf mask expression changed")
    endif()
    string(REPLACE "${original}" "${corrected}" contents "${contents}")
    file(WRITE "${source}" "${contents}")
endif()

set(original "  int finalLevel;\n\n  Assert2(level <= activeLevels);")
set(corrected "  int finalLevel;\n\n  if (level < 0 || level >= KNLevels) {\n    throw std::length_error(\"SequenceHeap exhausted its merge levels\");\n  }\n  Assert2(level <= activeLevels);")
string(FIND "${contents}" "${corrected}" already_patched)
if(already_patched EQUAL -1)
    string(FIND "${contents}" "${original}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Pinned SequenceHeap merge-level entry changed")
    endif()
    string(REPLACE "${original}" "${corrected}" contents "${contents}")
    set(original "    finalLevel = makeSpaceAvailable(level + 1);")
    set(corrected "    if (level + 1 >= KNLevels) {\n      throw std::length_error(\"SequenceHeap exhausted its merge levels\");\n    }\n    finalLevel = makeSpaceAvailable(level + 1);")
    string(FIND "${contents}" "${original}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Pinned SequenceHeap recursive merge-level expression changed")
    endif()
    string(REPLACE "${original}" "${corrected}" contents "${contents}")
    file(WRITE "${source}" "${contents}")
endif()
