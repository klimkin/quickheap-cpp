{% set clang_exe = os.getenv('CLANG') %}
{% if clang_exe %}
{% set clang_version = subprocess.check_output([clang_exe, '-dumpversion'], text=True).strip().split('.')[0] %}
{% else %}
{% set compiler, detected_version, clang_exe = detect_api.detect_clang_compiler() %}
{% set clang_version = detect_api.default_compiler_version(compiler, detected_version) %}
{% endif %}
{% set clangxx_exe = os.getenv('CLANGXX') or os.path.join(os.path.dirname(clang_exe), os.path.basename(clang_exe).replace('clang', 'clang++')) %}

[settings]
os=Linux
arch=x86_64
compiler=clang
compiler.version={{ clang_version }}
compiler.libcxx=libstdc++11
compiler.cppstd=20
build_type=Release

[conf]
tools.build:compiler_executables={'c': '{{ clang_exe }}', 'cpp': '{{ clangxx_exe }}'}
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:jobs=8

[buildenv]
CC={{ clang_exe }}
CXX={{ clangxx_exe }}
