{% set gcc_exe = os.getenv('GCC') %}
{% if gcc_exe %}
{% set gcc_version = subprocess.check_output([gcc_exe, '-dumpversion'], text=True).strip().split('.')[0] %}
{% else %}
{% set compiler, detected_version, gcc_exe = detect_api.detect_gcc_compiler() %}
{% set gcc_version = detect_api.default_compiler_version(compiler, detected_version) %}
{% endif %}
{% set gxx_exe = os.getenv('GXX') or os.path.join(os.path.dirname(gcc_exe), os.path.basename(gcc_exe).replace('gcc', 'g++')) %}

[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version={{ gcc_version }}
compiler.libcxx=libstdc++11
compiler.cppstd=20
build_type=Release

[conf]
tools.build:compiler_executables={'c': '{{ gcc_exe }}', 'cpp': '{{ gxx_exe }}'}
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:jobs=8

[buildenv]
CC={{ gcc_exe }}
CXX={{ gxx_exe }}
